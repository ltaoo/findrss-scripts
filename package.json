{
  "name": "findrss-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:runtime": "node scripts/prepare_runtime.js",
    "build": "npm run setup:runtime && node --import ./test/support/worker_runtime.js scripts/build.js",
    "openapi": "npm run build",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run",
    "pretest": "npm run build",
    "test": "node --import ./test/support/worker_runtime.js --test test/*.test.js",
    "check:routes": "node scripts/check_routes.js",
    "check:local": "node scripts/check_routes.js --local"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "fast-xml-parser": "4.5.7",
    "wrangler": "4.135.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
