    <item>
    <title>v260531</title>
    <link>https://github.com/ltaoo/wx_channels_download/releases/tag/v260531</link>
      <guid isPermaLink="false">tag:github.com,2008:Repository/865292903/v260531</guid>
    <description>修复 WXU.onFeed 在 global.js 脚本中没有正确调用的问题 #397
增加 /api/channels/parse_sph 接口，支持解析 分享链接 得到视频直链，无需解密即可播放、下载 #393
/api/channels/feed/profile 支持某些特殊的分享链接获取详情 #402

/api/channels/parse_sph 接口使用说明
不依赖视频号页面，可部署到 linux 服务器。需要在配置文件 config.yaml 中，进行如下配置，然后重启下载器即可

# config.yaml

cloudflare:
  sphCookie: "" # 从 yuanbao.tencent.com 登录后获取 cookie 填入
部署到 cloudflare
提供 cloudflare 各项参数，通过 wx_video_download sph_deploy 即可部署到 cloudflare worker，效果等同 https://sph.litao.workers.dev/

# config.yaml

cloudflare:
  accountId: "" # cloudflare Account Id
  apiToken: "" # cloudflare API Token，需要有 worker、pages 的权限
  sphWorkerName: "sph" # cloudflare worker 名称，可以自定义，会变成子域名
  sphCookie: "" # 从 yuanbao.tencent.com 登录后获取 cookie 填入</description>
      <content:encoded>&lt;ul&gt;
&lt;li&gt;修复 WXU.onFeed 在 global.js 脚本中没有正确调用的问题 &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4517029165" data-permission-text="Title is private" data-url="https://github.com/ltaoo/wx_channels_download/issues/397" data-hovercard-type="issue" data-hovercard-url="/ltaoo/wx_channels_download/issues/397/hovercard" href="https://github.com/ltaoo/wx_channels_download/issues/397"&gt;#397&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;增加 &lt;code&gt;/api/channels/parse_sph&lt;/code&gt; 接口，支持解析 分享链接 得到视频直链，无需解密即可播放、下载 &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4510816900" data-permission-text="Title is private" data-url="https://github.com/ltaoo/wx_channels_download/issues/393" data-hovercard-type="issue" data-hovercard-url="/ltaoo/wx_channels_download/issues/393/hovercard" href="https://github.com/ltaoo/wx_channels_download/issues/393"&gt;#393&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;code&gt;/api/channels/feed/profile&lt;/code&gt; 支持某些特殊的分享链接获取详情 &lt;a class="issue-link js-issue-link" data-error-text="Failed to load title" data-id="4530241021" data-permission-text="Title is private" data-url="https://github.com/ltaoo/wx_channels_download/issues/402" data-hovercard-type="issue" data-hovercard-url="/ltaoo/wx_channels_download/issues/402/hovercard" href="https://github.com/ltaoo/wx_channels_download/issues/402"&gt;#402&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;&lt;code&gt;/api/channels/parse_sph&lt;/code&gt; 接口使用说明&lt;/h3&gt;
&lt;p&gt;不依赖视频号页面，可部署到 &lt;code&gt;linux&lt;/code&gt; 服务器。需要在配置文件 &lt;code&gt;config.yaml&lt;/code&gt; 中，进行如下配置，然后重启下载器即可&lt;/p&gt;
&lt;div class="highlight highlight-source-yaml notranslate position-relative overflow-auto" data-snippet-clipboard-copy-content="# config.yaml

cloudflare:
  sphCookie: &amp;quot;&amp;quot; # 从 yuanbao.tencent.com 登录后获取 cookie 填入"&gt;&lt;pre&gt;&lt;span class="pl-c"&gt;&lt;span class="pl-c"&gt;#&lt;/span&gt; config.yaml&lt;/span&gt;

&lt;span class="pl-ent"&gt;cloudflare&lt;/span&gt;:
  &lt;span class="pl-ent"&gt;sphCookie&lt;/span&gt;: &lt;span class="pl-s"&gt;&lt;span class="pl-pds"&gt;"&lt;/span&gt;&lt;span class="pl-pds"&gt;"&lt;/span&gt;&lt;/span&gt; &lt;span class="pl-c"&gt;&lt;span class="pl-c"&gt;#&lt;/span&gt; 从 yuanbao.tencent.com 登录后获取 cookie 填入&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;
&lt;h3&gt;部署到 cloudflare&lt;/h3&gt;
&lt;p&gt;提供 &lt;code&gt;cloudflare&lt;/code&gt; 各项参数，通过 &lt;code&gt;wx_video_download sph_deploy&lt;/code&gt; 即可部署到 &lt;code&gt;cloudflare worker&lt;/code&gt;，效果等同 &lt;a href="https://sph.litao.workers.dev/" rel="nofollow"&gt;https://sph.litao.workers.dev/&lt;/a&gt;&lt;/p&gt;
&lt;div class="highlight highlight-source-yaml notranslate position-relative overflow-auto" data-snippet-clipboard-copy-content="# config.yaml

cloudflare:
  accountId: &amp;quot;&amp;quot; # cloudflare Account Id
  apiToken: &amp;quot;&amp;quot; # cloudflare API Token，需要有 worker、pages 的权限
  sphWorkerName: &amp;quot;sph&amp;quot; # cloudflare worker 名称，可以自定义，会变成子域名
  sphCookie: &amp;quot;&amp;quot; # 从 yuanbao.tencent.com 登录后获取 cookie 填入"&gt;&lt;pre&gt;&lt;span class="pl-c"&gt;&lt;span class="pl-c"&gt;#&lt;/span&gt; config.yaml&lt;/span&gt;

&lt;span class="pl-ent"&gt;cloudflare&lt;/span&gt;:
  &lt;span class="pl-ent"&gt;accountId&lt;/span&gt;: &lt;span class="pl-s"&gt;&lt;span class="pl-pds"&gt;"&lt;/span&gt;&lt;span class="pl-pds"&gt;"&lt;/span&gt;&lt;/span&gt; &lt;span class="pl-c"&gt;&lt;span class="pl-c"&gt;#&lt;/span&gt; cloudflare Account Id&lt;/span&gt;
  &lt;span class="pl-ent"&gt;apiToken&lt;/span&gt;: &lt;span class="pl-s"&gt;&lt;span class="pl-pds"&gt;"&lt;/span&gt;&lt;span class="pl-pds"&gt;"&lt;/span&gt;&lt;/span&gt; &lt;span class="pl-c"&gt;&lt;span class="pl-c"&gt;#&lt;/span&gt; cloudflare API Token，需要有 worker、pages 的权限&lt;/span&gt;
  &lt;span class="pl-ent"&gt;sphWorkerName&lt;/span&gt;: &lt;span class="pl-s"&gt;&lt;span class="pl-pds"&gt;"&lt;/span&gt;sph&lt;span class="pl-pds"&gt;"&lt;/span&gt;&lt;/span&gt; &lt;span class="pl-c"&gt;&lt;span class="pl-c"&gt;#&lt;/span&gt; cloudflare worker 名称，可以自定义，会变成子域名&lt;/span&gt;
  &lt;span class="pl-ent"&gt;sphCookie&lt;/span&gt;: &lt;span class="pl-s"&gt;&lt;span class="pl-pds"&gt;"&lt;/span&gt;&lt;span class="pl-pds"&gt;"&lt;/span&gt;&lt;/span&gt; &lt;span class="pl-c"&gt;&lt;span class="pl-c"&gt;#&lt;/span&gt; 从 yuanbao.tencent.com 登录后获取 cookie 填入&lt;/span&gt;&lt;/pre&gt;&lt;/div&gt;</content:encoded>
    <dc:creator>github-actions[bot]</dc:creator>
    </item>
  </channel>
</rss>
