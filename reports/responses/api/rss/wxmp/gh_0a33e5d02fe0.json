Jnk0P7EZ2OQ7Y7UBQ3uQL9bm73R2Yvo5mibd4w4e7XWCRSic44pibs2XXheTQyiavvQQtqg%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2025-03-29T09:10:22.000Z"},{"id":"wxmp:MzAxNDk0MDU2MA%3D%3D:2247484563:1","title":"AI驱动的安全创新：MCP技术的应用实践","link":"http://mp.weixin.qq.com/s?__biz=MzAxNDk0MDU2MA==&mid=2247484563&idx=1&sn=40a58bb09da26af940bf1958aa28c471&chksm=9ac924f0066ce314a03fbfdb0463b84ff516fb8ae48aa8fc7b308decdc5f3d0045118eb5c59e&scene=126&sessionid=1795853658#rd","description":"由知名大模型Claude的母公司Anthropic发布模型上下文协议（MCP, Model Context Protocol），它通过提供一个通用的标准接口，让AI应用能轻松连接到各种数据源，如数据库、API和企业工具。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fzegbd9UNPM3icRABYORuThJ3Qzb5wsj78kuQ0djBFl8iaYoqbfMribhGwwV4ibQRpeQmuONAthO6LCLict1QYDHha4A%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2025-02-27T10:32:42.000Z"},{"id":"wxmp:MzAxNDk0MDU2MA%3D%3D:2247484497:1","title":"关于BlackHat2023上JWT三个新攻击方式的学习笔记","link":"http://mp.weixin.qq.com/s?__biz=MzAxNDk0MDU2MA==&mid=2247484497&idx=1&sn=6d1cf4a0436c463b952305dd80c61327&chksm=9a82c698420e95026f45f150b3409862b7cf62f8fb881c8fef1d02f4b8518328fc97b997ddb2&scene=126&sessionid=1795853658#rd","description":"—最近看到去年的BlackHat针对JWT的三种新攻击方式的议题，便想着复现一下学习学习。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fzegbd9UNPM1TvMuD3nBa3XbRsM3hjdrAIFLtDLCRNPGuiacpqAeyPBGaRCL5IzZic5xicq6xFrJgSCLiaE8CTrQDibA%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2024-05-28T16:04:26.000Z"},{"id":"wxmp:MzAxNDk0MDU2MA%3D%3D:2247484446:1","title":"用GPT做静态代码扫描实现自动化漏洞挖掘思路分享","link":"http://mp.weixin.qq.com/s?__biz=MzAxNDk0MDU2MA==&mid=2247484446&idx=1&sn=4148de7d5a598b759f30f7c5b24925f1&chksm=9a4840e31cdc6d8eb0a71b3705aa83ae04f4b60f981a383df5cc8162470a233142f7190bafb5&scene=126&sessionid=1795853658#rd","description":"静态代码扫描结合GPT，本文分享了一种利用GPT技术结合静态代码扫描的自动化漏洞挖掘思路，让人工智能工具能够实际应用在生活、工作中。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fzegbd9UNPM0CscOkKGsYo5pjK0mI3IfV4I3QciacBVicJibiaibTonJJDpkA1SMuPeA8ibw4XQW00ic14ALtbyAuI5zlQ%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2023-03-20T09:54:00.000Z"},{"id":"wxmp:MzAxNDk0MDU2MA%3D%3D:2247484423:1","title":"ChatGPT的应用探索之路","link":"http://mp.weixin.qq.com/s?__biz=MzAxNDk0MDU2MA==&mid=2247484423&idx=1&sn=b1d29283b070dd27373e547c20916241&chksm=9a1393ed98996ae52c73f1fb40506656ba4ea0d3362f7e49d981ab9ed4c55d9e683d699b01db&scene=126&sessionid=1795853658#rd","description":"GPT是基于神经网络的自然语言处理技术，通过大规模预训练，使模型从海量文本中学习语言模式，提高文本生成效率和质量。它为自然语言处理领域带来了巨大进展，为各种应用场景提供了可靠高效的文本生成技术。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fzegbd9UNPM2EHicul2aeyC2Y76Bg77C70k420QiblGLBFtnG9CPCx6b6wf7mwRObqhCPwrbI8L8eSkjR2qPUMZZw%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2023-03-18T14:56:42.000Z"},{"id":"wxmp:MzAxNDk0MDU2MA%3D%3D:2247484387:1","title":"高对抗内存型WebShell检测技术学习笔记","link":"http://mp.weixin.qq.com/s?__biz=MzAxNDk0MDU2MA==&mid=2247484387&idx=1&sn=8cac0dead790d3a4ade58c251e3af386&chksm=9b8ae31cacfd6a0a662dc74f8764c29e61892ccc6e8a1821f4f51f9946acc1f0f7fc4c95b65b&scene=126&sessionid=1795853658#rd","description":"结内存型 Webshell 的特征和原理, 构建内存型 Webshell 威胁模型, 定义了高对抗内存型 Webshell, 并提出一种基于RASP(运行时应用程序自我保护)的动静态结合的高对抗内存型 Webshell 检测技术。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fzegbd9UNPM0OQv7BWIapsKe5DcwoeVq5D0PwrfXGwILwEwGc4VVgOMBUO7NK4Wg5SKLU8ngJwZR1HbeegNFdnQ%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2023-01-28T08:36:59.000Z"},{"id":"wxmp:MzAxNDk0MDU2MA%3D%3D:2247484368:1","title":"gRPC内存马研究与查杀","link":"http://mp.weixin.qq.com/s?__biz=MzAxNDk0MDU2MA==&mid=2247484368&idx=1&sn=6925d72ad1ff1e11bafe0429fb14215a&chksm=9b8ae32facfd6a39f009ef221fe0e672f5544afc8e5f26819a2e2fcdb473b31718b04a9bf723&scene=126&sessionid=1795853658#rd","description":"前两周看到M01N Team公众号发布的《内存马的攻防博弈之旅之gRPC内存马》，文中介绍了gRPC内存马是如何注入进去并执行命令的，但是由于原文当中只给出靶场的Demo，并未给出利用注入的poc，便借助这篇文章再深入研究一下。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fzegbd9UNPM3uc9oTZvlXQTxic2Q8ic075FVdKXBmqSibFBsoEtzCuT9vE9MChHj0qHyJuoSM7siclQyND2Xh6pujpQ%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2022-12-26T05:30:00.000Z"},{"id":"wxmp:MzAxNDk0MDU2MA%3D%3D:2247484344:1","title":"RASP的安全攻防研究实践","link":"http://mp.weixin.qq.com/s?__biz=MzAxNDk0MDU2MA==&mid=2247484344&idx=1&sn=7415904c7a9e1fac9d94a03fd68f3f59&chksm=9b8ae347acfd6a510388b9610ca5bbdc93f22910007e97257366bc3ed6812c3d86b767fd188c&scene=126&sessionid=1795853658#rd","description":"随着Web应用攻击手段变得复杂，基于请求特征的防护手段，已经不能满足企业安全防护需求。在2012年的时候，Gartner引入了“Runtime application self-protection”一词，简称为RASP。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fzegbd9UNPM2BDeaSMoiaibTKwPuBG0ibg2SS5jHmKSJ3UqiaLkGyqyrsCibL9Meia9hbhYDIYxbVduzjz10EwY30yuRQ%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2022-10-14T08:42:29.000Z"},{"id":"wxmp:MzAxNDk0MDU2MA%3D%3D:2247484309:1","title":"针对RASP检测反射场景下的对抗思考","link":"http://mp.weixin.qq.com/s?__biz=MzAxNDk0MDU2MA==&mid=2247484309&idx=1&sn=68b886219d8f76fdde1a05731781b382&chksm=9b8ae36aacfd6a7c4a46a164ffb7e9f5d202848d6056dda997e60b262d659e64d0bf618b3bcd&scene=126&sessionid=1795853658#rd","description":"最近在研究RASP的攻防场景，接触到利用JNI的方式绕过RASP的检测，同时研究了利用反射来关闭RASP的检测开关的时候，思考了一下防御视角可能会怎么防御。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fzegbd9UNPM3DX7S3FCYqncIiangibYl2tk3MpgdGsKXCnqwMjNOad6oGibKPSrfg5okbNkA1Y9KDDmZ8aFrGe63Qw%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2022-09-22T11:42:28.000Z"}]}