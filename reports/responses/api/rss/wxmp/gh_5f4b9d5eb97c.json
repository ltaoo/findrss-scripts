4ia0%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2026-11-21T11:38:27.000Z"},{"id":"wxmp:MjM5NjgzMzkwMQ%3D%3D:2653653407:1","title":"A社创业5年上市超万亿, \"神棍\"公司为什么只诞生在硅谷","link":"http://mp.weixin.qq.com/s?__biz=MjM5NjgzMzkwMQ==&mid=2653653407&idx=1&sn=f69764848d170a3cf42e1375c455b456&chksm=bc6df9c163dc660c142602e0caf4616f74304a6c10935b2c628911d0f09fbc4f074d41a24eab&scene=126&sessionid=1795529055#rd","description":"硅谷的底色是Think Different","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2FVauqib9kHbibW3jsPLzamDNlo7tlsdGmlQl7XPRaC8Nj2xw1uwcTTUyGXnvH7d4yic7YLBeiareXTHof5VYPZeE0wyC1ABp0jwWU1KY2biaRd6Dc%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2026-11-20T11:27:27.000Z"},{"id":"wxmp:MjM5NjgzMzkwMQ%3D%3D:2653653374:1","title":"每日硅谷AI早报：Anthropic正式上市，OpenAI被曝造手机，Google把AI送上太空","link":"http://mp.weixin.qq.com/s?__biz=MjM5NjgzMzkwMQ==&mid=2653653374&idx=1&sn=ac1338f97c2cbbc7f356e0f20e8f3861&chksm=bcefd5b7c1b68275c1258be512398e6266587d98e5272cfe89331dada05a69fb8c451051e8be&scene=126&sessionid=1795529055#rd","description":"每天2分钟，看懂AI圈新鲜事","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_jpg%2FVauqib9kHbibX9dDIO9KvuE5OY925WNrvKWEQE6Dia2jsfoq95xX3jssbehcKeiaX9QgYs74aq96wBnJnOSWC3tYw621Pmv6kePqK9avZR5fYbw%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2026-11-20T03:17:24.000Z"},{"id":"wxmp:MjM5NjgzMzkwMQ%3D%3D:2653653365:1","title":"科技研究与咨询机构Gartner最近发布了一份关于AI就业的预测：到2030年，AI将在全球创造1060万个岗位，同时替代890万个岗位，最终净增加170万个。\nAI越来越强，为什么创造的岗位反而比替代的更多？\n\n看看科技行业就知道了。\nGartner预计，到2030年，科技行业将新增190万个岗位，同时减少40万个，净增加150万个。近70%的科技行业员工都处于AI影响较大的岗位，但整个行业仍然在增长。\n\n原因很简单，AI不只是在替代原来的工作，它自己也在创造新的市场。\n模型研发需要人才，AI应用需要投入，企业使用AI还需要软件开发、系统部署和各种配套服务。\n与此同时，AI也在降低很多业务的成本，让一些过去投入太大、做起来不划算的产品和服务有了机会。\n\n不过，新业务的增长需要时间，企业减少招聘却可能来得更快。\nGartner预计，2026年AI将替代220万个岗位，同时创造160万个岗位。另外，企业因为AI而推迟招聘的岗位达到130万个。到2030年，这类被推迟创造的岗位累计可能达到500万个。\n\n企业已经开始重新考虑一个问题：业务增长到底需要多少人？哪些环节需要增加投入，哪些环节可以交给AI？省下来的成本，是直接变成利润，还是投入新的产品和业务？\n这就不只是使用什么AI工具的问题了，而是企业原来的组织方式还适不适应新的生产方式。\n\n很多企业现在做AI转型，第一反应是给每个部门配上AI工具就完事。研发用AI写代码，市场用AI做内容，销售用AI整理客户资料。\n但一家企业的业务不是由几个独立部门拼起来的。\n即使每个部门都用上了AI，如果部门之间的流程没有打通，决策还是层层汇报，资源还是按照原来的方式分配，AI带来的效率提升就可能卡在组织内部。\n\n这也是为什么我一直强调AI Native。它不是在原来的企业里增加几个AI工具，也不是要求每个员工都学会使用某个模型，而是从一开始就按照AI能够参与工作的方式，重新设计企业的业务流程和组织结构。\n\nAI时代，真正的竞争不只是技术和工具的竞争，更是组织变革的竞争。工具可以很快买到，但一家公司能不能改变自己的运转方式，才是真正拉开差距的地方。\n\n这几年我们也在做AI转型，踩了不少坑，也摸索出了一套方法。12月11日会在深圳办一场猎豹AI实战派线下课，从认知、管理到实操，讲讲我们真正做过的事。\n报名链接：cmcm.bot","link":"http://mp.weixin.qq.com/s?__biz=MjM5NjgzMzkwMQ==&mid=2653653365&idx=1&sn=3449e8c1d7b7749d80ae66e3aa838c11&chksm=bcaa6573b0cc4beeadeaaa789a59d6c8a9257b9ed2bfc38cf5645a9c5b0dc39ad71c5e48eed8&scene=126&sessionid=1795529055#rd","description":"","type":"article","published":"2026-11-19T11:13:45.000Z"},{"id":"wxmp:MjM5NjgzMzkwMQ%3D%3D:2653653363:1","title":"每日硅谷AI早报: 英伟达全员加薪，马斯克力挺黄仁勋，Anthropic创IPO纪录","link":"http://mp.weixin.qq.com/s?__biz=MjM5NjgzMzkwMQ==&mid=2653653363&idx=1&sn=05564618cc46c270cdfe5f552bab372e&chksm=bc93f87a9fbedf498119e36536a12d9b1cf204d4d9f41394ac74981b50b5127d09fc4b23610f&scene=126&sessionid=1795529055#rd","description":"每天2分钟，看懂AI圈新鲜事","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_jpg%2FVauqib9kHbibVCP35Pq6NhpAic9S4H7D5gq6iaU6ic1qIyYmeAPOTSxYK8Ddr5bbCeWJMFMLA4Bwbmmy4ZbO6Z2wru4Qn6fTeE514S8ANqmuaKHk%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2026-11-19T03:36:48.000Z"},{"id":"wxmp:MjM5NjgzMzkwMQ%3D%3D:2653653356:1","title":"黄仁勋想回来，董事会敢答应么？美股上市CEO现身说法","link":"http://mp.weixin.qq.com/s?__biz=MjM5NjgzMzkwMQ==&mid=2653653356&idx=1&sn=62c71d5de6e5cd8a92962ddbacda5e7d&chksm=bcee8e9d8a3ac4c9188f3d2dacb5ce72f75e5ec34b220afe0dfc2c5b93d2baf2633e9f0dff9a&scene=126&sessionid=1795529055#rd","description":"国会不站台，老黄回不来","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fmmbiz_jpg%2FVauqib9kHbibWn6vlYE8DlwibYazu59tY2ia9l02w3FibZkia8SZNE8TXQTIxJhib93AUia1tUGAgROOFh5xwklFZ3kvi