biz.qpic.cn%2Fsz_mmbiz_png%2FPXuFFGszgALBEdHNY0cWouUoLb6oQnv1XWdtflCWEyLb6CY5I61IictMZArQztCKDyibJ6EdBGkHeF23MqwH1RcQ%2F0","http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_png%2FPXuFFGszgALBEdHNY0cWouUoLb6oQnv1IgGpSJGX3OY5QkMJPueyUBbgicKyRPmJuYHexIxCw7OHj4xjaibzZUbQ%2F0","http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_png%2FPXuFFGszgALBEdHNY0cWouUoLb6oQnv1Cnzn9pEuIyz0H59gRnlToFCtuvicIVPEIwEGSJB5JiaVe0bYcr6Our8Q%2F0","http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_png%2FPXuFFGszgALBEdHNY0cWouUoLb6oQnv1HHia6JXPd3HCRia5ovvSibEE03x28XGnRxMfOr1qZh36ib23SrpGiblEia3w%2F0"],"type":"gallery","published":"2025-09-01T06:50:27.000Z"},{"id":"wxmp:MzIzMjM0NDk1NQ%3D%3D:2247500408:1","title":"短游戏宣言 Short Game Manifesto（2022）","link":"http://mp.weixin.qq.com/s?__biz=MzIzMjM0NDk1NQ==&mid=2247500408&idx=1&sn=ca88c24434099eda089e6368cca52107&chksm=e9c7c128fa11400c8758b2001d4ea4263e069a4575d6ff7f15b92d3416435ecf2312cdf20e06&scene=126&sessionid=1795635092#rd","description":"此图为2022年所写的短游戏宣言，时至今日也没有太多增补的欲望。前阵子受华东师范大学新传学院邀请，做了《关于电子游戏宣言》（On Manifestos of Video Games）的分享，而自己的状态也正从躁转郁，借机尝试一种新的写作和更新方式，以此文作始，与君共享。\n\n\n叶梓涛\n2025.8.30","content":"<p>此图为2022年所写的短游戏宣言，时至今日也没有太多增补的欲望。前阵子受华东师范大学新传学院邀请，做了《关于电子游戏宣言》（On Manifestos of Video Games）的分享，而自己的状态也正从躁转郁，借机尝试一种新的写作和更新方式，以此文作始，与君共享。<br /><br /><br />叶梓涛<br />2025.8.30</p>\n<img src=\"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_png%2FPXuFFGszgAI1K8Sib9D5f5AkCsfiaehn0GYhUwffZZtc6EEljUJIhcp0YpFxWr1Uoq2vRPHUIccEW4C3ibDKPv63g%2F0\" style=\"max-width:100%;height:auto;\" />","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2FPXuFFGszgAI1K8Sib9D5f5AkCsfiaehn0GYlXCB8923a7WehNMB5dez2C4IadicQKR4gZYZlwz9ble9vL5PwSCgSQ%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","images":["http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_png%2FPXuFFGszgAI1K8Sib9D5f5AkCsfiaehn0