.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fno8YFGgia2NFohkgbdcxeJ89DGxxLTZZiayQsTAibUia5RhsNoicc3TLqasV7JWnZias2ibFwpN5wS3xZ4mVs4bIsGCpk55LvdfYFgtM8vBBJicqfPg%2F300%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2026-11-07T03:03:35.000Z"},{"id":"wxmp:MzI2MTE0NTE3Mw%3D%3D:2651157976:1","title":"【开源报告】美国国家叙事情报中心深度调研","link":"http://mp.weixin.qq.com/s?__biz=MzI2MTE0NTE3Mw==&mid=2651157976&idx=1&sn=1f5d360eb5929dfe5423b72b66168ff7&chksm=f073e32cd672184a4fb2d4047ad674ef6cd727106323ecff151a6a87ca05b656d44cdd4d84d0&scene=126&sessionid=1795180785#rd","description":"国家叙事情报中心（NCNI，The National Center for Narrative Intelligence）是一个成立于 2023 年的美国机构，自称是\"美国在理解与塑造信息如何影响认知、决策与安全方面的枢纽\"，通过政府、产业、学术界及盟友专家网络开展工作。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fno8YFGgia2NGlvnlZaIEJBzycT0OZzePPH2MicEIFNN9F7FMXF096hEWoqnDTN7pFibaSc7gkUak0g3Onuyp0sB0x0uOdHTWODHvklFxUamOtU%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2026-11-06T05:56:10.000Z"},{"id":"wxmp:MzI2MTE0NTE3Mw%3D%3D:2651157969:1","title":"【工具】OSINT信息服务平台使用指南","link":"http://mp.weixin.qq.com/s?__biz=MzI2MTE0NTE3Mw==&mid=2651157969&idx=1&sn=3279a5398b09dfceb18ece896fd9f23e&chksm=f09cd66e02ba47da59fb98ff91dd95d19d30bd2ae404cc092120355520c4d385656366911156&scene=126&sessionid=1795180785#rd","description":"OSINT 信息服务平台 · 产品指南看见全球动态 读懂关键变化情报资讯 × 日报中心从发现线索，到积累研究成果。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fno8YFGgia2NEKHFhbEmWXYZslFVdAKbRuVvokJ2JqhicyriaJ3XDBN5kH8r138ASGWc75viaErEVghYoGF1ts6eD5C9D4eicTw4W8I3HPexvTRq0%2F640%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2026-11-05T15:54:46.000Z"},{"id":"wxmp:MzI2MTE0NTE3Mw%3D%3D:2651157969:2","title":"【资料】近期认知战专题文献汇总分析报告","link":"http://mp.weixin.qq.com/s?__biz=MzI2MTE0NTE3Mw==&mid=2651157969&idx=2&sn=8cb1ef4f0360504b9eee1e9427a8db96&chksm=f0a339156721d380dd6519c49acd3d8f1c39f63a838ee936125d00415b64b65fa3b615362206&scene=126&sessionid=1795180785#rd","description":"今天给大家分析9份近期发布的认知战相关文献，逐篇内容解析与跨文档主题归纳。","image":"http://script.findrss.cloud/img/wxmp?url=https%3A%2F%2Fmmbiz.qpic.cn%2Fsz_mmbiz_jpg%2Fno8YFGgia2NFyEZ94ydPUCwuZXRfSze7g4I67w6fSIvPiciaSLdPTMl3rAcWWf1AkiaiaIbgxOrIUvGOdl3SvwVniblc4iasib6cOxRvAAvlKyeg6hI%2F300%3Fwxtype%3Djpeg%26wxfrom%3D25","type":"article","published":"2026-11-05T15:54:46.000Z"}]}